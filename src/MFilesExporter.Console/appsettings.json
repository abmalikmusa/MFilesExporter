{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Sinks.Async",
      "Serilog.Expressions"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System":    "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    },
    "Enrich": [
      "FromLogContext", "WithMachineName", "WithEnvironmentUserName",
      "WithProcessId", "WithThreadId"
    ],
    "Properties": {
      "Application": "MFilesExporter"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "outputTemplate": "[{Timestamp:HH:mm:ss.fff} {Level:u3}] [{CorrelationId}] {SourceContext} - {Message:lj} {Properties:j}{NewLine}{Exception}"
              }
            },
            {
              "Name": "File",
              "Args": {
                "path": "logs/mfilesexporter-.log",
                "rollingInterval": "Day",
                "retainedFileCountLimit": 30,
                "fileSizeLimitBytes": 268435456,
                "rollOnFileSizeLimit": true,
                "shared": true,
                "buffered": true,
                "flushToDiskInterval": "00:00:02",
                "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
              }
            },
            {
              "Name": "Logger",
              "Args": {
                "configureLogger": {
                  "Filter": [
                    { "Name": "ByIncludingOnly", "Args": { "expression": "@l in ['Warning','Error','Fatal']" } }
                  ],
                  "WriteTo": [
                    {
                      "Name": "File",
                      "Args": {
                        "path": "logs/errors-.log",
                        "rollingInterval": "Day",
                        "retainedFileCountLimit": 90,
                        "fileSizeLimitBytes": 134217728,
                        "rollOnFileSizeLimit": true,
                        "shared": true,
                        "buffered": false,
                        "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
                      }
                    }
                  ]
                }
              }
            },
            {
              "Name": "Logger",
              "Args": {
                "configureLogger": {
                  "Filter": [
                    { "Name": "ByIncludingOnly", "Args": { "expression": "Category = 'Audit'" } }
                  ],
                  "WriteTo": [
                    {
                      "Name": "File",
                      "Args": {
                        "path": "logs/audit-.log",
                        "rollingInterval": "Day",
                        "retainedFileCountLimit": 2555,
                        "shared": true,
                        "buffered": false,
                        "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
                      }
                    }
                  ]
                }
              }
            },
            {
              "Name": "Logger",
              "Args": {
                "configureLogger": {
                  "Filter": [
                    { "Name": "ByIncludingOnly", "Args": { "expression": "Category = 'Performance'" } }
                  ],
                  "WriteTo": [
                    {
                      "Name": "File",
                      "Args": {
                        "path": "logs/performance-.log",
                        "rollingInterval": "Day",
                        "retainedFileCountLimit": 30,
                        "fileSizeLimitBytes": 268435456,
                        "rollOnFileSizeLimit": true,
                        "shared": true,
                        "buffered": true,
                        "flushToDiskInterval": "00:00:05",
                        "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
                      }
                    }
                  ]
                }
              }
            },
            {
              "Name": "Logger",
              "Args": {
                "configureLogger": {
                  "Filter": [
                    { "Name": "ByIncludingOnly", "Args": { "expression": "Category = 'Worker'" } }
                  ],
                  "WriteTo": [
                    {
                      "Name": "File",
                      "Args": {
                        "path": "logs/workers-.log",
                        "rollingInterval": "Day",
                        "retainedFileCountLimit": 14,
                        "fileSizeLimitBytes": 268435456,
                        "rollOnFileSizeLimit": true,
                        "shared": true,
                        "buffered": true,
                        "flushToDiskInterval": "00:00:05",
                        "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
                      }
                    }
                  ]
                }
              }
            }
          ],
          "bufferSize": 10000,
          "blockWhenFull": true
        }
      }
    ]
  },
  "Exporter": {
    "Source": {
      "ConnectionString": "Server=localhost;Database=MFilesVault;Integrated Security=True;Encrypt=True;TrustServerCertificate=True;Application Name=MFilesExporter",
      "CommandTimeoutSeconds": 120,
      "EnumerationBatchSize": 1000,
      "UseReadUncommittedForEnumeration": true,
      "PartitionKey": "default",
      "Tables": {
        "DocumentFileVersion": "DOCUMENTFILEVERSION",
        "DataFileVersion": "DATAFILEVERSION",
        "DataFileVersionBytes": "DATAFILEVERSION_BYTES"
      }
    },
    "Storage": {
      "RootPath": "./export-output/documents",
      "ManifestPath": "./export-output/manifests",
      "ShardDepth": 2,
      "WriteBufferSize": 81920,
      "ManifestRotationEntryCount": 100000,
      "FsyncManifestOnRotate": true,
      "PreserveOriginalFilename": true,
      "MinimumFreeSpaceGb": 50
    },
    "Pipeline": {
      "EnumerationChannelCapacity": 5000,
      "ContentChannelCapacity": 128,
      "ContentReaderConcurrency": 8,
      "SinkConcurrency": 8,
      "ProgressReportInterval": "00:00:05",
      "CheckpointFlushInterval": "00:00:02",
      "OutcomeBatchSize": 200,
      "OutcomeBatchFlushInterval": "00:00:02",
      "MaxDocumentSizeMb": 0
    },
    "Resilience": {
      "SqlRead":     { "MaxRetryAttempts": 5, "BaseDelayMilliseconds": 500, "MaxDelaySeconds": 30, "TimeoutSeconds": 300, "CircuitBreakerFailureRatio": 0.5, "CircuitBreakerMinimumThroughput": 20, "CircuitBreakerSamplingSeconds": 30, "CircuitBreakerBreakSeconds": 60 },
      "SqlBlobRead": { "MaxRetryAttempts": 5, "BaseDelayMilliseconds": 500, "MaxDelaySeconds": 30, "TimeoutSeconds": 600, "CircuitBreakerFailureRatio": 0.5, "CircuitBreakerMinimumThroughput": 20, "CircuitBreakerSamplingSeconds": 30, "CircuitBreakerBreakSeconds": 60 },
      "DiskWrite":   { "MaxRetryAttempts": 3, "BaseDelayMilliseconds": 250, "MaxDelaySeconds": 15, "TimeoutSeconds": 300, "CircuitBreakerFailureRatio": 0.5, "CircuitBreakerMinimumThroughput": 20, "CircuitBreakerSamplingSeconds": 30, "CircuitBreakerBreakSeconds": 30 },
      "StateStore":  { "MaxRetryAttempts": 5, "BaseDelayMilliseconds": 100, "MaxDelaySeconds":  5, "TimeoutSeconds":  30, "CircuitBreakerFailureRatio": 0.5, "CircuitBreakerMinimumThroughput": 50, "CircuitBreakerSamplingSeconds": 30, "CircuitBreakerBreakSeconds": 15 }
    },
    "StateStore": {
      "Provider": "sqlite",
      "ConnectionString": "./export-output/state.db",
      "EnableMemoryMappedIo": true,
      "CacheSizeKib": 65536,
      "WalCheckpointInterval": "00:05:00"
    },
    "Dashboard": {
      "Enabled": true,
      "RefreshInterval": "00:00:00.500",
      "MaxWorkerRows": 16,
      "MaxDocumentKeyLength": 48,
      "DisableWhenOutputRedirected": true
    },
    "Telemetry": {
      "ServiceName": "mfiles-exporter",
      "ServiceNamespace": "seamfix",
      "ServiceVersion": "1.0.0",
      "EnablePrometheusEndpoint": true,
      "PrometheusListenerUrl": "http://+:9464/",
      "EnableOtlpExporter": false,
      "OtlpEndpoint": null,
      "TraceSamplingRatio": 0.05
    }
  }
}
