<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CA1707;CA1861;CA2007;CA1305;NU1902</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MFilesExporter.Domain\MFilesExporter.Domain.csproj" />
    <ProjectReference Include="..\..\src\MFilesExporter.Shared\MFilesExporter.Shared.csproj" />
    <ProjectReference Include="..\..\src\MFilesExporter.Configuration\MFilesExporter.Configuration.csproj" />
    <ProjectReference Include="..\..\src\MFilesExporter.Logging\MFilesExporter.Logging.csproj" />
    <ProjectReference Include="..\..\src\MFilesExporter.Application\MFilesExporter.Application.csproj" />
    <ProjectReference Include="..\..\src\MFilesExporter.Persistence\MFilesExporter.Persistence.csproj" />
    <ProjectReference Include="..\..\src\MFilesExporter.Export\MFilesExporter.Export.csproj" />
    <ProjectReference Include="..\..\src\MFilesExporter.Reporting\MFilesExporter.Reporting.csproj" />
    <ProjectReference Include="..\..\src\MFilesExporter.Infrastructure\MFilesExporter.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\MFilesExporter.Console\MFilesExporter.Console.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.MsSql" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\database\*.sql" Link="database\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
